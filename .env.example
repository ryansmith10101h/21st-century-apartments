# ==============================================================================
# 21ST CENTURY APARTMENTS — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.
# ==============================================================================

# APPLICATION URL (update after Vercel deployment)
NEXT_PUBLIC_APP_URL=https://21stcenturyapartments.ng

# SUPABASE CONFIGURATION
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key — NEVER expose this to the browser/client
# Used only in server-side API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ADMIN DASHBOARD CREDENTIALS
# Create this user in Supabase Auth → Users
ADMIN_DEFAULT_EMAIL=admin@21stcenturyapartments.ng
ADMIN_DEFAULT_PASSWORD=Change_This_To_A_Strong_Password!

# WHATSAPP CONCIERGE NUMBER
# Country code without +, no spaces (e.g. 2348176115993)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348176115993
